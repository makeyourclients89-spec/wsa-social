@echo off
title WSA Social - 1-Click Extension Installer v1.2.5
color 0b
cls

echo ========================================================================
echo         WSA SOCIAL - CHROME EXTENSION 1-CLICK INSTALLER (v1.2.5)
echo ========================================================================
echo.

set "TARGET_DIR=%LOCALAPPDATA%\WSASocialExtension"
set "TEMP_ZIP=%TEMP%\wsa_ext_temp_%RANDOM%.zip"

if not exist "%TARGET_DIR%" (
    mkdir "%TARGET_DIR%" >nul 2>&1
)

echo [1/3] Extracting extension to:
echo       %TARGET_DIR% ...

certutil -decode "%~f0" "%TEMP_ZIP%" >nul 2>&1
if not exist "%TEMP_ZIP%" (
    echo [ERROR] Failed to extract archive. Trying PowerShell fallback...
    powershell -NoProfile -ExecutionPolicy Bypass -Command "Write-Host 'Extracting...'"
)

powershell -NoProfile -ExecutionPolicy Bypass -Command "if (Test-Path '%TEMP_ZIP%') { Expand-Archive -Path '%TEMP_ZIP%' -DestinationPath '%TARGET_DIR%' -Force; Remove-Item '%TEMP_ZIP%' -Force -ErrorAction SilentlyContinue }"

if exist "%TARGET_DIR%\manifest.json" (
    echo [OK] Extension files ready!
) else (
    echo [WARNING] Could not verify manifest.json.
)
echo.

echo [2/3] Copying folder path to clipboard...
powershell -NoProfile -ExecutionPolicy Bypass -Command "Set-Clipboard -Value '%TARGET_DIR%'"
echo [OK] Path copied to clipboard: %TARGET_DIR%
echo.

echo [3/3] Opening Chrome Extensions and Extension Folder...
set "CHROME_BIN="
if exist "%ProgramFiles%\Google\Chrome\Application\chrome.exe" set "CHROME_BIN=%ProgramFiles%\Google\Chrome\Application\chrome.exe"
if exist "%ProgramFiles(x86)%\Google\Chrome\Application\chrome.exe" set "CHROME_BIN=%ProgramFiles(x86)%\Google\Chrome\Application\chrome.exe"
if exist "%LocalAppData%\Google\Chrome\Application\chrome.exe" set "CHROME_BIN=%LocalAppData%\Google\Chrome\Application\chrome.exe"

if defined CHROME_BIN (
    start "" "%CHROME_BIN%" "chrome://extensions"
) else (
    start "" "chrome.exe" "chrome://extensions" >nul 2>&1
)

start "" explorer.exe "%TARGET_DIR%"

echo.
echo ========================================================================
echo                       INSTALLATION COMPLETE!
echo ========================================================================
echo.
echo Chrome me bas yeh 2 simple steps karein:
echo.
echo  1. Chrome me top-right me 'Developer mode' ON karein (agar OFF hai).
echo  2. Agar extension pehle se load thi to bas uska 'Reload' (circle) icon dabayein.
echo     Agar pehli baar hai, to top-left me 'Load unpacked' dabakar Ctrl+V karein!
echo.
echo  WSA Social Dashboard tab open rakhein - Extension automatically us se connect ho jayegi!
echo.
echo ========================================================================
echo Press any key to close this window...
pause >nul
exit /b 0

