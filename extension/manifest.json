{
  "manifest_version": 3,
  "name": "WSA Social - Auto Facebook Group Share",
  "version": "1.2.3",
  "description": "Zero-Click Automatic Sharing with Active Reel Preview Detection, Diagnostics & Viral Hashtags.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WSA Social Auto-Pilot",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.app.github.dev/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/groups/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.app.github.dev/*",
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
